// ===== QUICK TEST FOR LINH LANGUAGE =====
print("=== QUICK LINH TEST ===")

// Variables
var x = 42
var y = 3.14
var s = "Hello"
print("Variables:", x, y, s)

// Arrays
var arr = [1, 2, 3]
arr.append(4)
arr.remove(2)
print("Array:", arr)

// Maps
var m = {"a": 1, "b": 2}
m.delete("b")
print("Map:", m)

// Functions
func add(a, b) { return a + b }
print("Function:", add(5, 3))

// Control flow
if x > 40 {
    print("x is large")
}

for var i = 1; i <= 3; i = i + 1 {
    print("Loop:", i)
}

print("=== TEST COMPLETE ===")

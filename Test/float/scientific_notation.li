// Test scientific notation (E/e notation)
print(1e5)        // 100000.0
print(1.23e4)     // 12300.0
print(2.5E-3)     // 0.0025
print(1.0e+2)     // 100.0
print(5e-2)       // 0.05
print(3.14159E0)  // 3.14159
print(1E10)       // 10000000000.0
print(2.5e+10)    // 25000000000.0
print(1.5e-10)    // 0.00000000015
